DATABASE_URL=mysql+pymysql://root:@localhost:3306/gpon_db
JWT_SECRET=change-moi-en-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3000

# Optionnel : laisser vide pour garder la simulation Zabbix (aucune erreur, pas de vrai serveur requis).
# Renseigner pour activer la vraie intégration (host.get / problem.get) :
ZABBIX_URL=
ZABBIX_USER=
ZABBIX_PASSWORD=
# Alternative à USER/PASSWORD si vous utilisez un jeton API Zabbix (6.4+) :
ZABBIX_API_TOKEN=
